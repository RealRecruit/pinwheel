<% content_for :title, @project.name %>

<div class="mb-2 text-sm">
  <%= link_to "← Projects", account_projects_path(Current.account), class: "text-gray-500 hover:text-gray-700" %>
</div>

<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-semibold"><%= @project.name %></h1>
    <p class="text-sm text-gray-500">Created by <%= @project.creator.name %> on <%= @project.created_at.to_date.to_fs(:long) %></p>
  </div>

  <% unless @project.archived? %>
    <%= button_to "Archive", account_project_archival_path(Current.account, @project),
          form: { data: { turbo_confirm: "Archive #{@project.name}? Everyone on the project will get an email." } },
          class: "rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm hover:bg-gray-50 cursor-pointer" %>
  <% end %>
</div>

<% if @project.archived? %>
  <div class="mb-6 rounded-md bg-yellow-50 px-4 py-2 text-sm text-yellow-800">
    This project was archived on <%= @project.archived_at.to_date.to_fs(:long) %>.
  </div>
<% end %>

<% if @project.description.present? %>
  <div class="mb-8 text-gray-700 whitespace-pre-line"><%= @project.description %></div>
<% end %>

<section class="mb-8">
  <h2 class="text-lg font-medium mb-3">People</h2>

  <% if @project.assigned_users.any? %>
    <ul class="flex flex-wrap gap-2 mb-4">
      <% @project.assigned_users.order(:name).each do |user| %>
        <li class="rounded-full bg-gray-100 px-3 py-1 text-sm"><%= user.name %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-gray-600 mb-4">Nobody is assigned yet.</p>
  <% end %>

  <% if !@project.archived? && @project.assignable_users.any? %>
    <%= form_with model: Assignment.new, url: account_project_assignments_path(Current.account, @project), class: "flex items-center gap-2" do |form| %>
      <%= form.collection_select :user_id, @project.assignable_users, :id, :name, {}, class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm" %>
      <%= form.submit "Assign", class: "rounded-md bg-blue-600 px-3 py-1.5 text-sm text-white font-medium hover:bg-blue-500 cursor-pointer" %>
    <% end %>
  <% end %>
</section>

<section id="comments">
  <h2 class="text-lg font-medium mb-3">Comments</h2>

  <% if @project.comments.any? %>
    <ul class="space-y-3 mb-6">
      <%= render partial: "comments/comment", collection: @project.comments.chronologically.includes(:creator) %>
    </ul>
  <% else %>
    <p class="text-sm text-gray-600 mb-6">No comments yet.</p>
  <% end %>

  <% unless @project.archived? %>
    <%= render "comments/form", project: @project, comment: @comment || Comment.new %>
  <% end %>
</section>
