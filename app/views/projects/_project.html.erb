<li>
  <%= link_to account_project_path(project.account, project), class: "block px-4 py-3 hover:bg-gray-50" do %>
    <div class="flex items-baseline justify-between gap-4">
      <span class="font-medium"><%= project.name %></span>
      <span class="text-xs text-gray-500 shrink-0">
        <% if project.archived? %>
          Archived <%= time_ago_in_words(project.archived_at) %> ago
        <% else %>
          <%= pluralize(project.assignments.size, "person") %> &middot; <%= pluralize(project.comments.size, "comment") %>
        <% end %>
      </span>
    </div>
    <% if project.description.present? %>
      <p class="mt-1 text-sm text-gray-600 truncate"><%= project.description %></p>
    <% end %>
  <% end %>
</li>
