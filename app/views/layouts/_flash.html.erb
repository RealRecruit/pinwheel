<% if notice.present? %>
  <div id="notice" class="mb-6 rounded-md bg-green-50 px-4 py-2 text-sm font-medium text-green-700"><%= notice %></div>
<% end %>

<% if alert.present? %>
  <div id="alert" class="mb-6 rounded-md bg-red-50 px-4 py-2 text-sm font-medium text-red-700"><%= alert %></div>
<% end %>
