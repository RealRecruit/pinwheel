<header class="bg-white border-b border-gray-200">
  <nav class="max-w-4xl mx-auto px-4 h-14 flex items-center gap-6">
    <%= link_to "Pinwheel", root_path, class: "font-semibold text-lg" %>

    <%= render "layouts/account_switcher" %>

    <div class="ml-auto flex items-center gap-4 text-sm">
      <%= link_to "Settings", settings_path, class: "text-gray-600 hover:text-gray-900" %>
      <%= button_to "Sign out", session_path, method: :delete, class: "text-gray-600 hover:text-gray-900 cursor-pointer" %>
    </div>
  </nav>
</header>
