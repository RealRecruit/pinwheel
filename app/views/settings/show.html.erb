<% content_for :title, "Settings" %>

<h1 class="text-2xl font-semibold mb-6">Settings</h1>

<section class="bg-white border border-gray-200 rounded-lg p-6 mb-6">
  <h2 class="text-lg font-medium mb-4">Profile</h2>

  <%= form_with model: @user, url: settings_path, method: :patch, class: "space-y-4" do |form| %>
    <%= render "shared/errors", record: @user %>

    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :name, required: true, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:outline-blue-600" %>
    </div>

    <div>
      <%= form.label :email_address, class: "block text-sm font-medium text-gray-700" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:outline-blue-600" %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.submit "Save", class: "rounded-md bg-blue-600 px-4 py-2 text-white font-medium hover:bg-blue-500 cursor-pointer" %>
      <%= link_to "Change password", new_password_path(email_address: @user.email_address), class: "text-sm text-gray-600 underline hover:no-underline" %>
    </div>
  <% end %>
</section>

<section class="bg-white border border-gray-200 rounded-lg p-6">
  <h2 class="text-lg font-medium mb-1">Devices</h2>
  <p class="text-sm text-gray-600 mb-4">Phones and tablets signed in to the Pinwheel app.</p>

  <% if @devices.any? %>
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-gray-500 border-b border-gray-200">
          <th class="py-2 font-medium">Name</th>
          <th class="py-2 font-medium">Platform</th>
          <th class="py-2 font-medium">Last seen</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @devices.each do |device| %>
          <tr>
            <td class="py-2"><%= device.name.presence || "Unnamed device" %></td>
            <td class="py-2"><%= device.platform_name %></td>
            <td class="py-2 text-gray-600"><%= device.last_seen_at ? "#{time_ago_in_words(device.last_seen_at)} ago" : "Never" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-sm text-gray-600">No devices yet.</p>
  <% end %>
</section>
