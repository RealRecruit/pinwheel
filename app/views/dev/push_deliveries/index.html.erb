<% content_for :title, "Push deliveries" %>

<div class="flex items-baseline justify-between mb-6">
  <h1 class="text-2xl font-semibold">Push deliveries</h1>
  <%= link_to "Sent emails", "/letter_opener", class: "text-sm text-gray-600 underline hover:no-underline" %>
</div>

<% if @push_deliveries.any? %>
  <div class="overflow-x-auto bg-white border border-gray-200 rounded-lg">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-gray-500 border-b border-gray-200">
          <th class="px-4 py-2 font-medium">Delivered</th>
          <th class="px-4 py-2 font-medium">User</th>
          <th class="px-4 py-2 font-medium">Device</th>
          <th class="px-4 py-2 font-medium">Title</th>
          <th class="px-4 py-2 font-medium">Body</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @push_deliveries.each do |delivery| %>
          <tr class="align-top">
            <td class="px-4 py-2 whitespace-nowrap text-gray-600"><%= delivery.delivered_at&.to_fs(:short) %></td>
            <td class="px-4 py-2 whitespace-nowrap"><%= delivery.user.name %></td>
            <td class="px-4 py-2 whitespace-nowrap"><%= delivery.device.name %> <span class="text-gray-400">(<%= delivery.device.platform_name %>)</span></td>
            <td class="px-4 py-2"><%= delivery.title %></td>
            <td class="px-4 py-2 text-gray-600"><%= delivery.body %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-gray-600">Nothing has been pushed yet.</p>
<% end %>
